<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child  link="laser_frame"/>
        <origin xyz="0.122 0 0.212" rpy="0 0 0"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!--
        Ignition Fortress gpu_lidar sensor, now configured as a 3D LIDAR.

        CRITICAL: use <lidar> child element, NOT <ray>.
        <ray> is Gazebo Classic syntax. Ignition silently ignores it,
        the topic exists and the bridge connects, but zero messages
        are ever published.

        The world-level Sensors plugin (ignition_world.world) drives
        this sensor. No <plugin> block is needed here. render_engine
        ogre2 (set in ignition_world.world) is what GPU-accelerates
        this sensor; type="gpu_lidar" rasterizes all rays on the GPU
        instead of the CPU-based "lidar"/"ray" sensor types.

        Coverage (per bugfix/map-rotation-fix -> feature/3d-lidar):
          Horizontal: 172 deg total, centered on the robot's front
            (+X of laser_frame), i.e. +/-86 deg = +/-1.500983 rad.
          Vertical:   60 deg total. Rays START at the LIDAR's own
            level (0 rad = the horizontal plane through the sensor,
            perpendicular to the sensor's vertical axis) and sweep
            UP to +60 deg (1.047198 rad). min_vertical_angle is 0,
            NOT -30/+30, so no rays point below the sensor's plane.

        Topic renamed from 'scan' to 'scan_2d': this sensor has 16
        vertical rings, so Ignition's native LaserScan serialization
        on this topic is degenerate/unusable (LaserScan can only carry
        one ring). Ignition publishes:
          - /scan_2d         (ignition.msgs.LaserScan; degenerate 3D dump,
                               not used directly by any consumer)
          - /scan_2d/points  (ignition.msgs.PointCloudPacked; the real
                               3D data, bridged to ROS as PointCloud2)
        pointcloud_to_laserscan.launch.py consumes /scan_2d/points and
        republishes a proper single-ring 2D LaserScan on ROS topic
        /scan, which scan_frame_fixer (in gz.launch.py) then rewrites
        to /scan_fixed for SLAM Toolbox / Nav2, exactly as it did
        before this sensor became 3D.
    -->
    <gazebo reference="laser_frame">
        <material>Gazebo/Red</material>

        <sensor name="laser" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <update_rate>10</update_rate>
            <always_on>1</always_on>
            <visualize>false</visualize>
            <topic>scan_2d</topic>
            <frame_id>laser_frame</frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>345</samples>
                        <resolution>1</resolution>
                        <min_angle>-1.500983</min_angle>
                        <max_angle>1.500983</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>16</samples>
                        <resolution>1</resolution>
                        <min_angle>0.0</min_angle>
                        <max_angle>1.047198</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
            </lidar>
        </sensor>
    </gazebo>

</robot>
