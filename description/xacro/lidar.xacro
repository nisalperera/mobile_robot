<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <!-- SLAMTEC RPLIDAR C1, simplified planar scan model.
      Sources: https://www.slamtec.com/en/c1
               https://www.waveshare.com/wiki/RPLIDAR_C1
      Envelope 55.6x55.6x41.3 mm approximated by cylinder (NOT exact CAD).
      Mass 0.10 kg is an UNVERIFIED placeholder retained from previous lidar.
      Selected scan rate 10 Hz; 500 samples/revolution approximates 5000/s.
      Limits .05-12m are nominal: reflectance-dependent range, timing, angular
      jitter, reflectivity and hardware noise are NOT reproduced.
      User diagram central XY mount; chosen scan-plane Z=.110 is provisional.
      Assumed optical plane 31.3 mm above housing bottom, not surveyed.
      Housing bottom Z=.0787; top=.120; camera tops=.074, so planar beam clears
      proposed camera housings. Pedestal connects plate Z=.018 to .0787.
      Keep legacy sensor name, laser_frame and scan_2d topic for current launch.
      Single vertical ring replaces old 32-ring 3D lidar. Point cloud topic can
      remain scan_2d/points, but actual output must be verified in Gazebo.
    -->
    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/><child link="laser_frame"/>
        <origin xyz="0.150 0 0.110" rpy="0 0 0"/>
    </joint>
    <link name="laser_frame">
        <visual>
            <origin xyz="0 0 -0.01065"/>
            <geometry><cylinder radius="0.0278" length="0.0413"/></geometry>
            <material name="black"/>
        </visual>
        <collision>
            <origin xyz="0 0 -0.01065"/>
            <geometry><cylinder radius="0.0278" length="0.0413"/></geometry>
        </collision>
        <!-- Visual-only pedestal: no added mass or collision. -->
        <visual>
            <origin xyz="0 0 -0.06165"/>
            <geometry><cylinder radius="0.008" length="0.0607"/></geometry>
            <material name="black"/>
        </visual>
        <xacro:inertial_cylinder mass="0.1" length="0.0413" radius="0.0278">
            <origin xyz="0 0 -0.01065" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>
    <gazebo reference="laser_frame">
        <material>Gazebo/Black</material>
        <sensor name="laser" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <update_rate>10</update_rate><always_on>1</always_on>
            <visualize>false</visualize><topic>scan_2d</topic>
            <frame_id>laser_frame</frame_id>
            <lidar>
                <scan>
                    <!-- 500 evenly spaced azimuths; omit duplicated +pi ray. -->
                    <horizontal>
                        <samples>500</samples><resolution>1</resolution>
                        <min_angle>${-pi}</min_angle>
                        <max_angle>${pi-2*pi/500}</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>1</samples><resolution>1</resolution>
                        <min_angle>0</min_angle><max_angle>0</max_angle>
                    </vertical>
                </scan>
                <range><min>0.05</min><max>12.0</max><resolution>0.015</resolution></range>
            </lidar>
        </sensor>
    </gazebo>
</robot>
