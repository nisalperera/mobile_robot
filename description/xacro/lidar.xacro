<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child  link="laser_frame"/>
        <origin xyz="0.122 0 0.212" rpy="0 0 0"/>
    </joint>

    <link name="laser_frame">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!--
        Ignition Fortress gpu_lidar sensor, now configured as a 3D LIDAR.

        CRITICAL: use <lidar> child element, NOT <ray>.
        <ray> is Gazebo Classic syntax. Ignition silently ignores it,
        the topic exists and the bridge connects, but zero messages
        are ever published.

        The world-level Sensors plugin (ignition_world.world) drives
        this sensor. No <plugin> block is needed here. render_engine
        ogre2 (set in ignition_world.world) is what GPU-accelerates
        this sensor; type="gpu_lidar" rasterizes all rays on the GPU
        instead of the CPU-based "lidar"/"ray" sensor types.

        Coverage (per bugfix/map-rotation-fix -> feature/3d-lidar):
          Horizontal: 172 deg total, centered on the robot's front
            (+X of laser_frame), i.e. +/-86 deg = +/-1.500983 rad.
          Vertical:   60 deg total. Rays START at the LIDAR's own
            level (0 rad = the horizontal plane through the sensor,
            perpendicular to the sensor's vertical axis) and sweep
            UP to +60 deg (1.047198 rad). min_vertical_angle is 0,
            NOT -30/+30, so no rays point below the sensor's plane.

        Topic: Ignition publishes on global /scan (confirmed via ign topic -l).
        Bridge maps Ignition /scan -> ROS /scan in ros_gz_bridge.yaml.

        NOTE: With >1 vertical sample this is a true 3D point cloud.
        The bridged sensor_msgs/LaserScan on /scan can only carry a
        single ring and should be treated as a debug/legacy view of
        the bottom-most ring only. Consume full 3D returns from the
        already-bridged /scan/points (sensor_msgs/PointCloud2)
        instead, e.g. point Nav2's voxel_layer observation source
        at /scan/points with data_type: "PointCloud2" rather than
        /scan with data_type: "LaserScan", so obstacles across the
        full 60 deg vertical FOV are marked/cleared.
    -->
    <gazebo reference="laser_frame">
        <material>Gazebo/Red</material>

        <sensor name="laser" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <update_rate>10</update_rate>
            <always_on>1</always_on>
            <visualize>false</visualize>
            <topic>scan</topic>
            <frame_id>laser_frame</frame_id>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>345</samples>
                        <resolution>1</resolution>
                        <min_angle>-1.500983</min_angle>
                        <max_angle>1.500983</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>16</samples>
                        <resolution>1</resolution>
                        <min_angle>0.0</min_angle>
                        <max_angle>1.047198</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.3</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
            </lidar>
        </sensor>
    </gazebo>

</robot>
