<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       xmlns:ignition="http://gazebosim.org/schema">
    <!--
        xmlns:ignition namespace above is REQUIRED for the
        <fdir1 ignition:expressed_in="..."> attribute below to survive
        xacro processing. On Gazebo Fortress the attribute is
        "ignition:expressed_in" (Garden+ renames it "gz:expressed_in").
    -->

    <xacro:include filename="$(find mobile_robot)/description/xacro/inertial_macros.xacro" />

    <!-- Front right wheel -->
    <joint name="front_right_wheel_joint" type="continuous">
        <parent link="chassis" />
        <child link="front_right_wheel" />
        <origin xyz="0.25 -0.175 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1" />
    </joint>

    <link name="front_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.024" length="0.025" />
            </geometry>
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.024" length="0.025" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.025" radius="0.024">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- Rear right wheel -->
    <joint name="rear_right_wheel_joint" type="continuous">
        <parent link="chassis" />
        <child link="rear_right_wheel" />
        <origin xyz="0.05 -0.175 0" rpy="${pi/2} 0 0"/>
        <axis xyz="0 0 -1" />
    </joint>

    <link name="rear_right_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.024" length="0.025" />
            </geometry>
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.024" length="0.025" />
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.025" radius="0.024">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!--
        Mecanum roller friction emulation (Gazebo Fortress / ODE physics).

        Real 45-deg rollers are NOT modeled as geometry here - instead we
        keep the plain cylinder collision and fake roller behavior with
        anisotropic friction:
          - mu1 (high, along fdir1) = the wheel's effective push direction,
            i.e. the direction force actually gets transmitted to the ground.
          - mu2 (near zero, auto-computed orthogonal to fdir1) = the
            roller's free-slip axis, letting the wheel "skate" sideways.

        Roller pairing is DIAGONAL, not left/right:
          front_right + rear_left   -> Type B, fdir1 = "0.70710678 -0.70710678 0"
          front_left  + rear_right  -> Type A, fdir1 = "0.70710678  0.70710678 0"

        fdir1 is expressed_in="chassis" so the vector means the same thing
        regardless of each wheel link's own rotated joint frame. It is
        normalized to unit length (1/sqrt(2) ~= 0.70710678) since
        Gazebo/ODE expects fdir1 to be a unit vector.
    -->
    <gazebo reference="front_right_wheel">
        <material>Gazebo/Black</material>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.02</mu2>
                        <fdir1 ignition:expressed_in="chassis">0.70710678 -0.70710678 0</fdir1>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>

    <gazebo reference="rear_right_wheel">
        <material>Gazebo/Black</material>
        <collision>
            <surface>
                <friction>
                    <ode>
                        <mu>1.0</mu>
                        <mu2>0.02</mu2>
                        <fdir1 ignition:expressed_in="chassis">0.70710678 0.70710678 0</fdir1>
                    </ode>
                </friction>
                <contact>
                    <ode>
                        <min_depth>0.001</min_depth>
                    </ode>
                </contact>
            </surface>
        </collision>
    </gazebo>

</robot>
