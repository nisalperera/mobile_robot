<?xml version="1.0"?>
<!--
  Corrected example: 4x ZED 2 stereo camera mount on a square mobile robot chassis.

  Verified against the actual zed_macro.urdf.xacro source (stereolabs/zed-ros2-wrapper,
  master branch). Real macro signature:
    params="name=zed model=zed enable_gnss=false custom_baseline=0 *gnss_origin"

  Key facts:
  - There is NO "parent" attribute on this macro. It only creates a standalone
    "${name}_camera_link" link; you must attach it to your robot yourself via
    a separate fixed joint.
  - The "*gnss_origin" block parameter has no default, so xacro requires a
    block to be passed even when enable_gnss=false (it's simply unused then).
-->
<robot name="four_zed_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== Chassis parameters ==================== -->
  <xacro:property name="half_side" value="0.25"/>   <!-- meters, edit to match chassis -->
  <xacro:property name="cam_height" value="0.20"/>  <!-- meters above base_link -->
  <xacro:property name="cam_model" value="zed2"/>

  <!-- ==================== Base link ==================== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.50 0.50 0.15"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.50 0.50 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0" iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <!-- ==================== Include ZED macro ==================== -->
  <xacro:include filename="$(find zed_wrapper)/urdf/zed_macro.urdf.xacro"/>

  <!-- ==================== Front camera (facing +X, 0 deg) ==================== -->
  <xacro:zed_camera name="zed_front" model="${cam_model}">
    <origin xyz="0 0 0" rpy="0 0 0"/>  <!-- unused placeholder for gnss_origin -->
  </xacro:zed_camera>
  <joint name="zed_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_front_camera_link"/>
    <origin xyz="${half_side} 0.0 ${cam_height}" rpy="0 0 0"/>
  </joint>

  <!-- ==================== Right camera (facing -Y, -90 deg) ==================== -->
  <xacro:zed_camera name="zed_right" model="${cam_model}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:zed_camera>
  <joint name="zed_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_right_camera_link"/>
    <origin xyz="0.0 -${half_side} ${cam_height}" rpy="0 0 -1.5707963"/>
  </joint>

  <!-- ==================== Back camera (facing -X, 180 deg) ==================== -->
  <xacro:zed_camera name="zed_back" model="${cam_model}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:zed_camera>
  <joint name="zed_back_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_back_camera_link"/>
    <origin xyz="-${half_side} 0.0 ${cam_height}" rpy="0 0 3.1415927"/>
  </joint>

  <!-- ==================== Left camera (facing +Y, 90 deg) ==================== -->
  <xacro:zed_camera name="zed_left" model="${cam_model}">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:zed_camera>
  <joint name="zed_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="zed_left_camera_link"/>
    <origin xyz="0.0 ${half_side} ${cam_height}" rpy="0 0 1.5707963"/>
  </joint>

</robot>

<!--
  Notes:
  1. Each zed_camera call creates "<name>_camera_link", "<name>_camera_center",
     "<name>_left_camera_frame", "<name>_right_camera_frame", and their
     optical frames, all internally relative to "<name>_camera_link".
     Your external joint below each macro call is what actually positions
     that whole camera assembly on your chassis.

  2. The nested <origin xyz="0 0 0" rpy="0 0 0"/> inside each <xacro:zed_camera>
     block is a required placeholder for the "*gnss_origin" block parameter.
     It has no effect unless you also pass enable_gnss="true".

  3. Overlap math unchanged: ZED2 FOV (~110 deg) - 90 deg spacing between
     adjacent camera axes = ~20 deg overlap per seam on a square chassis.

  4. If your local zed_wrapper install differs from this master-branch source
     (e.g., older tagged release), re-verify with:
       grep -n 'xacro:macro name="zed_camera"' \
         $(ros2 pkg prefix zed_wrapper)/share/zed_wrapper/urdf/zed_macro.urdf.xacro
-->